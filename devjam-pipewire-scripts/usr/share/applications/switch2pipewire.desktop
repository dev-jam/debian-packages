[Desktop Entry]
Version=1.0
Name=Switch to Pipewire mode
GenericName=Switch to Pipewire mode
Comment=Disable Pulse and Enable Pipewire
Exec=sh -c "switch2pipewire && notify-send -i audio-on 'Switch to Pipewire mode' 'Disable Pulse and Enable Pipewire' || notify-send -u critical -i dialog-error 'Switch to Pipewire mode' 'Failed: Disable Pulse and Enable Pipewire'"
Icon=audio-on
StartupNotify=true
Type=Application
Categories=AudioVideo;
