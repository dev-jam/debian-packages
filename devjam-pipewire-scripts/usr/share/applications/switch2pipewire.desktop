[Desktop Entry]
Version=1.0
Type=Application
Name=Switch to PipeWire mode
Comment=Start PipeWire again after ALSA only mode
Exec=sh -c "switch2pipewire && notify-send -a Audio -i audio-volume-high 'PipeWire mode' 'PipeWire is running again and handles all sound.' || notify-send -a Audio -u critical -i dialog-error 'PipeWire mode' 'Could not start PipeWire. If ALSA only mode was made persistent, use Switch to PipeWire mode (persistent). Run switch2pipewire in a terminal to see why.'"
Icon=audio-volume-high
StartupNotify=false
Categories=AudioVideo;Audio;
