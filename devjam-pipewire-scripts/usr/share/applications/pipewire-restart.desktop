[Desktop Entry]
Version=1.0
Name=Restart Pipewire
GenericName=Restart Pipewire
Comment=Restart the Pipewire server
Exec=sh -c "pipewire-restart && notify-send -i audio-on 'Restart Pipewire' 'Restart the Pipewire server' || notify-send -u critical -i dialog-error 'Restart Pipewire' 'Failed: Restart the Pipewire server'"
Icon=audio-on
StartupNotify=true
Type=Application
Categories=AudioVideo;
