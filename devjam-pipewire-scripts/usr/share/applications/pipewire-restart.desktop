[Desktop Entry]
Version=1.0
Type=Application
Name=Restart PipeWire
Comment=Restart PipeWire, WirePlumber and pipewire-pulse
Exec=sh -c "pipewire-restart && notify-send -a Audio -i view-refresh 'PipeWire restarted' 'The sound system has been restarted.' || notify-send -a Audio -u critical -i dialog-error 'PipeWire restart failed' 'Could not restart PipeWire. Run pipewire-restart in a terminal to see why.'"
Icon=view-refresh
StartupNotify=false
Categories=AudioVideo;Audio;
