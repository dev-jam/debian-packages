[Desktop Entry]
Version=1.0
Name=Switch to ALSA only mode
GenericName=Switch to ALSA only mode
Comment=Disable Pulse and Pipewire and only use ALSA
Exec=sh -c "switch2alsa && notify-send -i audio-on 'Switch to ALSA only mode' 'Disable Pulse and Pipewire and only use ALSA' || notify-send -u critical -i dialog-error 'Switch to ALSA only mode' 'Failed: Disable Pulse and Pipewire and only use ALSA'"
Icon=audio-on
StartupNotify=true
Type=Application
Categories=AudioVideo;
