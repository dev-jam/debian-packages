#!/usr/bin/env bash
# Copyright (C) 2025-2026 Bob Rosbag <mail@bobrosbag.nl>
# SPDX-License-Identifier: GPL-3.0-or-later
# Wrapper that activates the venv, then starts OpenSesame.
#
# With OPENSESAME_CPUS=isolated (set by opensesame-psychopy-rt.service),
# OpenSesame runs on the CPUs isolated with isolcpus= in experiment mode, so
# it follows the CPU preset chosen in the GRUB menu. A CPUAffinity= of the
# service (set with manage-opensesame-affinity) wins. The inherited affinity
# says nothing: the user service manager can have every CPU in it.
VENV_DIR="/opt/psychopy/PsychoPy/.venv"
SERVICE="opensesame-psychopy-rt.service"

if [[ ! -f "$VENV_DIR/bin/activate" ]]; then
    echo "Error: PsychoPy venv not found in $VENV_DIR" >&2
    echo "       Install it with install-psychopy-opensesame." >&2
    exit 1
fi
source "$VENV_DIR/bin/activate"

# The inline_script editor (pyqt_code_editor) lints with Ruff, which writes a
# .ruff_cache directory next to the experiment. The cache gives no speed gain
# for scripts this small, so it is off. Set RUFF_NO_CACHE=false to keep it.
export RUFF_NO_CACHE="${RUFF_NO_CACHE:-true}"

if [[ ${OPENSESAME_CPUS:-} == isolated ]]; then
    isolated=$(cat /sys/devices/system/cpu/isolated 2>/dev/null)
    fixed=$(systemctl --user show -p CPUAffinity --value "$SERVICE" 2>/dev/null)
    if [[ -n $isolated && -z $fixed ]]; then
        exec taskset -c "$isolated" opensesame "$@"
    fi
fi

exec opensesame "$@"
