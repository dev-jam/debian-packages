#!/bin/sh
set -e

case "$1" in
    remove|purge)

        # Reload udev rules and trigger events
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload || true
            udevadm trigger || true
        fi
        ;;
esac

case "$1" in
    remove|abort-install|disappear)
        dpkg-divert --package devjam-science-tools --remove --rename \
            --divert /usr/share/applications/tobiiproeyetrackermanager.desktop.distrib \
            /usr/share/applications/tobiiproeyetrackermanager.desktop
        ;;
esac

exit 0
