#!/bin/sh

# Usage:
#   install-psychopy-opensesame          Install standard PsychoPy (with OpenSesame) + PsychoPy Studio
#   install-psychopy-opensesame --dev    Install ONLY the dev environment in /opt/psychopy/PsychoPy-dev:
#                                        Python 3.13, PsychoPy from its git dev branch and
#                                        the dev-jam plugins from git (default branch HEAD)
#   install-psychopy-opensesame --help   Show this help

# Copyright (C) 2022-2026 Bob Rosbag <mail@bobrosbag.nl>
# SPDX-License-Identifier: GPL-3.0-or-later

set -e

INSTALL_DIR="/opt/psychopy"
STD_VENV_NAME="PsychoPy"
DEV_VENV_NAME="PsychoPy-dev"
VERIFY_SCRIPT="/usr/lib/devjam-science-tools/verify-venv-packages.py"
INSTALLER_URL="https://github.com/wieluk/psychopy_linux_installer/releases/latest/download/psychopy_linux_installer"
DEV_GIT_BASE="https://github.com/dev-jam"
# Dev environment: PsychoPy from the dev branch of github.com/psychopy/psychopy
# (pyglet 2, Python 3.11-3.14; no release yet on 2026-11-22). Python 3.13 also
# allows opensesame-extension-sigmund >= 1.5.0 (sigmund-mcp-relay needs >= 3.13).
# psychopy_linux_installer officially supports Python 3.8-3.10; for a newer
# Python it only logs a warning. "git" installs the dev branch HEAD and no
# psychopy-app (see the accepted GUI error below).
DEV_PYTHON_VERSION="3.13"
DEV_PSYCHOPY_VERSION="git"

# Already root (e.g. a live-build chroot hook): no sudo needed or installed
if [ "$(id -u)" -eq 0 ]; then
    SUDO=""
else
    SUDO="sudo"
fi

# User to set up (psychopy group, PATH); empty in a build chroot (env -i),
# then no user is added and the group has to be assigned elsewhere
TARGET_USER="${SUDO_USER:-${USER:-}}"

# --- ARGUMENT PARSING ---
MODE="standard"
for arg in "$@"; do
    case "$arg" in
        --dev) MODE="dev" ;;
        -h|--help)
            sed -n '3,8p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "Unknown option: $arg" >&2
            echo "Use --help for usage." >&2
            exit 1
            ;;
    esac
done

# --cleanup (psychopy_linux_installer): after each run remove the uv, pip and
# Python download caches, the uv tools and the build packages the installer
# added itself. The venvs and their Python stay. Keeps caches out of a
# live image when this runs from a live-build hook.

# Relation to the official OpenSesame Linux installer (linux-installer.sh,
# branch nightingale): the same OpenSesame packages, PyGaze 0.8.8 and the
# expyriment 0.10.0+opensesame2 wheel are installed. Deliberate differences:
# - psychopy_linux_installer uses Python 3.10 (it supports 3.8-3.10 only), so
#   psychopy needs no --ignore-requires-python (psychopy requires <3.13).
# - expyriment is installed with its dependencies, so it brings pygame. The
#   official installer uses --no-deps plus pygame-ce, only because pygame has
#   no Python 3.14 wheels. pygame-ce must NOT be added here: it ships the same
#   "pygame" module and would overwrite pygame.
# - No --pre: on 2026-11-22 none of the OpenSesame packages had a newer
#   pre-release than the stable release.
# - All extra packages go into one uv resolver run (before psychopy itself),
#   not into separate pip steps as in the official script.
# Known limit of Python 3.10: opensesame-extension-sigmund >= 1.5.0 needs
# pyqt_code_editor >= 1.3, which needs sigmund-mcp-relay (Python >= 3.13).
# The resolver therefore stays at sigmund 1.4.2 and pyqt_code_editor 1.2.0,
# and the OpenSesame updater keeps offering an update that cannot install.

# Packages shared by the standard and the dev environment
PKGS_COMMON="
I2MC,
PyQt6-WebEngine,
fastnumbers,
https://github.com/open-cogsci/opensesame-windows-build-scripts/raw/refs/heads/master/libs/expyriment-0.10.0+opensesame2-py3-none-any.whl,
https://github.com/smathot/PyGaze/archive/refs/tags/release/0.8.8.tar.gz,
opensesame-core,
opensesame-extension-osweb,
opensesame-extension-updater,
opensesame-plugin-eyelink,
opensesame-plugin-media_player_mpy,
opensesame-plugin-psychopy,
opensesame-eyelink-coregraphics,
pygame-eyelink-coregraphics,
pipewire_python,
psychopy_bids,
psychopy-crs==0.0.2,
psychopy-brainproducts,
psychopy-eyelink,
psychopy-eyelink-coregraphics,
psychopy-eyetracker-sr-research,
psychopy-legacy-mic,
psychopy-mri-emulator,
psychopy-pyo,
psychopy-visionscience,
psychopy_sounddevice,
psychtoolbox,
sr-research-pylink,
seedir,
titta,
tittapy,
tittalslpy
"

# dev-jam plugins: PyPI release wheels (standard environment)
PKGS_PLUGINS_PYPI="
opensesame-plugin-audio-low-latency,
opensesame-plugin-experiment-manager,
opensesame-plugin-parallel-port-trigger,
opensesame-plugin-radboudbox,
opensesame-plugin-screenshot,
opensesame-plugin-titta-eyetracking
"

# dev-jam plugins: git repositories (dev environment)
# Note: repo names use underscores; no branch is pinned, so HEAD of each repo's
# default branch is installed.
PKGS_PLUGINS_GIT="
git+${DEV_GIT_BASE}/opensesame-plugin-audio_low_latency.git,
git+${DEV_GIT_BASE}/opensesame-plugin-experiment_manager.git,
git+${DEV_GIT_BASE}/opensesame-plugin-parallel_port_trigger.git,
git+${DEV_GIT_BASE}/opensesame-plugin-radboudbox.git,
git+${DEV_GIT_BASE}/opensesame-plugin-screenshot.git,
git+${DEV_GIT_BASE}/opensesame-plugin-titta_eyetracking.git
"

# Join package lists into a single string without spaces or newlines for installer arguments
join_pkgs() {
    printf '%s,%s' "$1" "$2" | tr -d ' \n' | sed 's/,,*/,/g; s/^,//; s/,$//'
}

PKGS_STD_STRING=$(join_pkgs "$PKGS_COMMON" "$PKGS_PLUGINS_PYPI")
PKGS_DEV_STRING=$(join_pkgs "$PKGS_COMMON" "$PKGS_PLUGINS_GIT")

# Function to print visual banners/separators
print_banner() {
    echo ""
    echo "================================================================================"
    echo "  $1"
    echo "================================================================================"
    echo ""
}

# Function to print a package list as bullets
print_pkgs() {
    echo "     --------------------------------------------------------------------------"
    echo "$1" | tr ',' '\n' | sed '/^[[:space:]]*$/d; s/^[[:space:]]*/       • /'
    echo "     --------------------------------------------------------------------------"
}

# Check that every requested package ended up in the venv. psychopy_linux_installer
# falls back to installing one package at a time when the batch fails, and then
# only logs "WARNING: Failed to install '...'. Skipping." and still exits 0.
# Arguments: venv name, comma-separated package list
verify_pkgs() {
    venv_python="${INSTALL_DIR}/$1/.venv/bin/python"
    if [ ! -x "$venv_python" ]; then
        echo "ERROR: $venv_python not found." >&2
        return 1
    fi
    "$venv_python" -I "$VERIFY_SCRIPT" "$2"
}

# --- INSTALLATION SUMMARY ---
print_banner "INSTALLATION SUMMARY"

echo "The following components will be installed:"
echo ""
if [ "$MODE" = "dev" ]; then
    TOTAL_STEPS=2
    echo "1. PsychoPy DEV (version: ${DEV_PSYCHOPY_VERSION}, dev branch; Python ${DEV_PYTHON_VERSION})"
    echo "   - Location: ${INSTALL_DIR}/${DEV_VENV_NAME}"
    echo "   - dev-jam plugins from git (default branch):"
    print_pkgs "$PKGS_PLUGINS_GIT"
    echo "   - Other additional packages (PyPI):"
    print_pkgs "$PKGS_COMMON"
else
    TOTAL_STEPS=3
    echo "1. Standard PsychoPy (version: latest)"
    echo "   - Location: ${INSTALL_DIR}/PsychoPy"
    echo "   - Including the following additional packages:"
    print_pkgs "$PKGS_COMMON,$PKGS_PLUGINS_PYPI"
    echo ""
    echo "2. PsychoPy Studio"
    echo "   - Location: ${INSTALL_DIR}/PsychoPy-studio"
    echo "   - WITHOUT additional packages"
fi
echo ""
echo "================================================================================"
echo ""

# --- STEP 1: DOWNLOAD / UPDATE INSTALLER ---
print_banner "[1/${TOTAL_STEPS}] Updating / Installing PsychoPy Linux Installer..."
echo "Downloading latest version of psychopy_linux_installer to /usr/local/bin..."
# Download to a temporary file first, so a failed or partial download never
# replaces a working installer
INSTALLER_TMP=$(mktemp)
trap 'rm -f "$INSTALLER_TMP"' EXIT
curl --fail --retry 3 -L -o "$INSTALLER_TMP" "$INSTALLER_URL"
if ! head -n 1 "$INSTALLER_TMP" | grep -q '^#!'; then
    echo "Downloaded file is not a script: $INSTALLER_URL" >&2
    exit 1
fi
$SUDO install -m 0755 "$INSTALLER_TMP" /usr/local/bin/psychopy_linux_installer
echo "psychopy_linux_installer $(sed -n 's/^SCRIPT_VERSION="\(.*\)"/\1/p' /usr/local/bin/psychopy_linux_installer) installed."

if [ "$MODE" = "dev" ]; then
    # --- STEP 2 (DEV): INSTALL PSYCHOPY DEV ---
    print_banner "[2/${TOTAL_STEPS}] Installing PsychoPy DEV (dev-jam plugins from git)..."
    installer_rc=0
    $SUDO /usr/local/bin/psychopy_linux_installer \
      --psychopy-version="$DEV_PSYCHOPY_VERSION" \
      --python-version="$DEV_PYTHON_VERSION" \
      --target-users="$TARGET_USER" \
      --desktop-shortcuts=none \
      --install-dir="$INSTALL_DIR" \
      --venv-name="$DEV_VENV_NAME" \
      --force-overwrite \
      --sudo-mode=auto \
      --log-level=info \
      --non-interactive \
      --cleanup \
      --additional-packages="$PKGS_DEV_STRING" || installer_rc=$?

    # With --psychopy-version=git, psychopy_linux_installer 3.1.0 checks the
    # GUI with "import psychopy.app.psychopyApp". On the PsychoPy dev branch
    # psychopy/app only re-exports psychopy_app, which the installer does not
    # install in git mode, so that check always fails, as the very last step.
    # OpenSesame only needs the psychopy library, so that one error is
    # accepted; any other error still stops the script. The PsychoPy GUI
    # (PsychoPy-dev, start_psychopy) does not work in this environment.
    if [ "$installer_rc" -ne 0 ]; then
        # shellcheck disable=SC2016 # $1 is expanded by the inner sh
        installer_log=$($SUDO sh -c 'ls -t "$1"/psychopy_linux_installer_*.log 2>/dev/null | head -n 1' sh "${INSTALL_DIR}/${DEV_VENV_NAME}")
        last_error=""
        if [ -n "$installer_log" ]; then
            last_error=$($SUDO grep ' - ERROR: ' "$installer_log" | tail -n 1)
        fi
        case "$last_error" in
            *"ERROR: PsychoPy is installed but its GUI cannot be loaded:"*)
                echo ""
                echo "WARNING: psychopy_linux_installer could not load the PsychoPy GUI"
                echo "         (no psychopy_app in git mode). OpenSesame does not need it;"
                echo "         the PsychoPy GUI of this environment does not start."
                ;;
            *)
                echo "ERROR: psychopy_linux_installer failed (exit code $installer_rc)." >&2
                exit "$installer_rc"
                ;;
        esac
    fi

    echo ""
    echo "Checking the installed packages..."
    verify_pkgs "$DEV_VENV_NAME" "$PKGS_DEV_STRING"
else
    # --- STEP 2: INSTALL STANDARD PSYCHOPY ---
    print_banner "[2/${TOTAL_STEPS}] Installing Standard PsychoPy (with additional packages)..."
    $SUDO /usr/local/bin/psychopy_linux_installer \
      --psychopy-version=latest \
      --target-users="$TARGET_USER" \
      --desktop-shortcuts=none \
      --install-dir="$INSTALL_DIR" \
      --venv-name="$STD_VENV_NAME" \
      --force-overwrite \
      --sudo-mode=auto \
      --log-level=info \
      --non-interactive \
      --cleanup \
      --additional-packages="$PKGS_STD_STRING"

    echo ""
    echo "Checking the installed packages..."
    verify_pkgs "$STD_VENV_NAME" "$PKGS_STD_STRING"

    # --- STEP 3: INSTALL PSYCHOPY STUDIO ---
    print_banner "[3/${TOTAL_STEPS}] Installing PsychoPy Studio (without additional packages)..."
    $SUDO /usr/local/bin/psychopy_linux_installer \
      --studio \
      --target-users="$TARGET_USER" \
      --desktop-shortcuts=none \
      --install-dir="$INSTALL_DIR" \
      --venv-name=PsychoPy-studio \
      --force-overwrite \
      --sudo-mode=auto \
      --log-level=info \
      --non-interactive \
      --cleanup
fi

print_banner "INSTALLATION SUCCESSFULLY COMPLETED!"
