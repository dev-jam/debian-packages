#!/bin/sh
set -e

dpkg-maintscript-helper rm_conffile /etc/skel/.bash_profile 1.23-5~ -- "$@"

case "$1" in
	configure)

		# Reload udev rules and trigger events
		if command -v udevadm >/dev/null 2>&1; then
			udevadm control --reload || true
			udevadm trigger || true
		fi

		# Set io schedulers to kyber
		switch-io kyber || true

		# Reload systemd daemon
		if command -v systemctl >/dev/null 2>&1; then
			systemctl daemon-reload || true
		fi

		# Regenerate grub.cfg for the GRUB drop-in
		if [ -e /boot/grub/grub.cfg ] && command -v update-grub >/dev/null 2>&1; then
			update-grub || true
		fi
		;;
esac

exit 0
