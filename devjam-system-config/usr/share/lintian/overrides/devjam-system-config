# Dotfiles for users created by live-config on Debian Live and for new
# users on installed systems; .bash_aliases also loads /etc/bashrc.d and
# ~/.config/bashrc.d (bash itself has no system-wide drop-in directory).
devjam-system-config: package-contains-file-in-etc-skel [etc/skel/.bash_aliases]
# Built with dpkg-deb, not debhelper: dpkg-maintscript-helper is called directly.
devjam-system-config: maintainer-script-should-not-use-dpkg-maintscript-helper *

# Man pages are not written yet; docs/man-pages.md lists which commands need one.
devjam-system-config: no-manual-page *
