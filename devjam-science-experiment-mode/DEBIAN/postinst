#!/bin/sh
set -e

dpkg-maintscript-helper rm_conffile /etc/kernel/postinst.d/99-grub-experiment-mode 1.1-1~ -- "$@"
dpkg-maintscript-helper rm_conffile /etc/kernel/postrm.d/99-grub-experiment-mode 1.1-1~ -- "$@"

case "$1" in
    configure)
        # Load 99-auto-pin-audio.rules. auto-pin-audio.service (started
        # below) pins the sound cards that are already there, so no udev
        # events are needed.
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload || true
        fi

        # auto-pin-audio-irq logs to the journal since 1.1-1.
        rm -f /var/log/auto-pin-audio_*.log

        # update-grub makes the GRUB entries since 1.1-1. Remove the log of
        # the old kernel hooks, and the hooks themselves where they were
        # still conffiles of devjam-science-experiment-mode-rtirq (an upgrade
        # straight from 1.46-1 or older), which rm_conffile does not cover.
        for f in /etc/kernel/postinst.d/99-grub-experiment-mode /etc/kernel/postrm.d/99-grub-experiment-mode; do
            if [ -f "$f" ] && ! dpkg-query -S "$f" >/dev/null 2>&1 \
                && grep -q update-grub-custom-experiment-mode "$f"; then
                rm -f "$f"
            fi
        done
        rm -rf /var/log/kernel-grub

        # switch-rtirq before 1.1-1 limited only rtirq.service to experiment
        # mode. Extend that choice to rtirq-resume.service, which also runs
        # "rtirq start" at boot and after suspend.
        if [ -f /etc/systemd/system/rtirq.service.d/experiment_mode.conf ] \
            && [ ! -f /etc/systemd/system/rtirq-resume.service.d/experiment_mode.conf ]; then
            mkdir -p /etc/systemd/system/rtirq-resume.service.d
            cp /usr/share/devjam/rtirq/experiment_mode.conf /etc/systemd/system/rtirq-resume.service.d/
        fi
        ;;
esac

# auto-pin-audio.service: enable on first installation and keep the
# administrator's choice on upgrades, then start it (the snippets
# dh_installsystemd generates). The enable state is kept per unit, so a
# choice made while the service was part of
# devjam-science-experiment-mode-rtirq carries over.
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
    # was-enabled defaults to true, so new installations run enable.
    if deb-systemd-helper --quiet was-enabled 'auto-pin-audio.service'; then
        deb-systemd-helper enable 'auto-pin-audio.service' >/dev/null || true
    else
        deb-systemd-helper update-state 'auto-pin-audio.service' >/dev/null || true
    fi
    if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null || true
        # A oneshot service: start runs it again (only in experiment mode).
        deb-systemd-invoke start 'auto-pin-audio.service' >/dev/null || true
    fi
fi

case "$1" in
    configure)
        # Add or update the experiment mode entries (/etc/grub.d/11_experiment_mode).
        if command -v update-grub >/dev/null 2>&1; then
            update-grub || true
        fi
        ;;
esac

exit 0
