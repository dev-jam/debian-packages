#!/bin/sh
set -e

case "$1" in
    remove)
        # Stop auto-pin-audio.service (the snippet dh_installsystemd generates)
        if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop 'auto-pin-audio.service' >/dev/null || true
        fi

        # Remove the experiment mode link that switch-rtirq creates
        conf_file="/etc/systemd/system/rtirq.service.d/experiment_mode.conf"
        if test -f "${conf_file}"; then
            rm -f "${conf_file}" 2>/dev/null || true
        fi
        conf_dir="/etc/systemd/system/rtirq.service.d"
        if test -d "${conf_dir}"; then
            rmdir "${conf_dir}" 2>/dev/null || true
        fi
        ;;
esac

exit 0
