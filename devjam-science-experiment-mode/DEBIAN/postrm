#!/bin/sh
set -e

dpkg-maintscript-helper rm_conffile /etc/kernel/postinst.d/99-grub-experiment-mode 1.1-1~ -- "$@"
dpkg-maintscript-helper rm_conffile /etc/kernel/postrm.d/99-grub-experiment-mode 1.1-1~ -- "$@"

case "$1" in
    remove)
        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null || true

            # irqbalance loses the experiment mode drop-in, rtirq is no
            # longer limited to experiment mode. deb-systemd-invoke only
            # (re)starts units that are enabled or running, and honours
            # policy-rc.d.
            deb-systemd-invoke restart 'irqbalance.service' 'rtirq.service' >/dev/null 2>&1 || true
        fi

        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload || true
        fi

        # /etc/grub.d/11_experiment_mode stays until purge, but adds no
        # entries without /usr/lib/devjam/experiment-mode/grub-entries.
        if command -v update-grub >/dev/null 2>&1; then
            update-grub 2>/dev/null || true
        fi
        ;;
    purge)
        # Forget the enable state of the services
        # (the snippet dh_installsystemd generates)
        if [ -x "/usr/bin/deb-systemd-helper" ]; then
            deb-systemd-helper purge 'auto-pin-audio.service' 'experiment-mode-cpus.service' >/dev/null || true
        fi
        ;;
esac

exit 0
