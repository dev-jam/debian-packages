#!/bin/sh
# Copyright (C) 2025-2026 Bob Rosbag <mail@bobrosbag.nl>
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Chooses when rtirq runs:
#   experiment   only in experiment mode (kernel parameter experiment_mode=1)
#   always       in normal and in experiment mode (default)
# It adds or removes a drop-in with ConditionKernelCommandLine for
# rtirq.service and rtirq-resume.service (which also runs "rtirq start", at
# boot and after suspend). Without an argument it shows the current choice.
# The old arguments still work: off = experiment, on/default = always.

units="rtirq.service rtirq-resume.service"
preset_file=/usr/share/devjam/rtirq/experiment_mode.conf

usage() {
    echo "Usage: ${0##*/} [experiment|always]"
}

drop_in() {
    echo "/etc/systemd/system/$1.d/experiment_mode.conf"
}

case "${1:-}" in
    "") action=status ;;
    experiment|off) action=experiment ;;
    always|on|default) action=always ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac

if [ "$action" != status ] && [ "$(id -u)" -ne 0 ]; then
    echo "Run as root (sudo ${0##*/} $1)." >&2
    exit 1
fi

case " $(cat /proc/cmdline) " in
    *" experiment_mode=1 "*) echo "Running in experiment mode" ;;
    *) echo "Running in normal mode" ;;
esac
echo "Isolated CPUs: $(grep . /sys/devices/system/cpu/isolated 2>/dev/null || echo none)"
echo

if [ "$action" != status ]; then
    for unit in $units; do
        if [ "$action" = experiment ]; then
            mkdir -p "$(dirname "$(drop_in "$unit")")"
            cp "$preset_file" "$(drop_in "$unit")"
        else
            rm -f "$(drop_in "$unit")"
            rmdir "$(dirname "$(drop_in "$unit")")" 2>/dev/null
        fi
    done
    systemctl daemon-reload
    # A restart stops rtirq and starts it again only where the condition holds.
    if systemctl is-enabled --quiet rtirq.service; then
        systemctl restart rtirq.service
    fi
fi

if [ -f "$(drop_in rtirq.service)" ]; then
    echo "rtirq runs only in experiment mode."
else
    echo "rtirq runs in normal and in experiment mode."
fi
echo "rtirq.service: $(systemctl is-enabled rtirq.service 2>/dev/null), $(systemctl is-active rtirq.service 2>/dev/null)"
