#!/bin/bash
# Copyright (C) 2025-2026 Bob Rosbag <mail@bobrosbag.nl>
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Checks the CPU isolation of experiment mode: the boot settings, the IRQs
# that run on isolated CPUs, and per CPU the load and the interrupts per
# second. A quiet isolated CPU shows almost no LOC (timer) and TIMER/RCU
# softirqs, except while a program runs on it.

set -u

usage() {
    cat <<EOF
Usage: ${0##*/} [-1] [SECONDS]
  SECONDS   seconds between updates (default 2)
  -1        print once and exit
Environment: ABS_THRESHOLD (default 90) marks normal CPUs above this load red.
EOF
}

ONCE=0
INTERVAL=2
for arg in "$@"; do
    case "$arg" in
        -1|--once) ONCE=1 ;;
        -h|--help) usage; exit 0 ;;
        *[!0-9]*|""|0) usage >&2; exit 2 ;;
        *) INTERVAL=$arg ;;
    esac
done
ABS_THRESHOLD=${ABS_THRESHOLD:-90}
BAR_WIDTH=30

if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
    GREEN=$'\e[32m' YELLOW=$'\e[33m' RED=$'\e[31m' BOLD=$'\e[1m' RESET=$'\e[0m' CLEAR=$'\e[H\e[J'
else
    GREEN="" YELLOW="" RED="" BOLD="" RESET="" CLEAR=""
fi
[ "$ONCE" = 1 ] && CLEAR=""

# "2-4,7" -> "2 3 4 7"
expand_cpus() {
    local part cpu
    local -a parts out=()
    IFS=, read -ra parts <<< "$1"
    for part in "${parts[@]}"; do
        if [[ $part =~ ^([0-9]+)-([0-9]+)$ ]]; then
            for ((cpu = BASH_REMATCH[1]; cpu <= BASH_REMATCH[2]; cpu++)); do
                out+=("$cpu")
            done
        elif [[ $part =~ ^[0-9]+$ ]]; then
            out+=("$part")
        fi
    done
    echo "${out[*]}"
}

# "0 1 2 3 8" -> "0-3,8"
compress_cpus() {
    local cpu start="" prev="" list=""
    for cpu in $1 ""; do
        if [ -n "$prev" ] && [ "$cpu" = "$((prev + 1))" ]; then
            prev=$cpu
            continue
        fi
        if [ -n "$start" ]; then
            if [ "$start" = "$prev" ]; then list+=",$start"; else list+=",$start-$prev"; fi
        fi
        start=$cpu prev=$cpu
    done
    echo "${list#,}"
}

# CPUs of a hex CPU mask ("0fffff03" or "ffffffff,00000003") -> "0 1 8 9 ..."
mask_to_cpus() {
    local hex=${1//,/} cpu=0 i digit bit list=""
    for ((i = ${#hex} - 1; i >= 0; i--)); do
        digit=$((16#${hex:i:1}))
        for bit in 0 1 2 3; do
            if ((digit >> bit & 1)); then list+=" $((cpu + bit))"; fi
        done
        cpu=$((cpu + 4))
    done
    echo "${list# }"
}

# --- Boot settings (do not change while running) ---

CMDLINE=" $(cat /proc/cmdline) "
ISOLATED=$(cat /sys/devices/system/cpu/isolated 2>/dev/null)
NOHZ_FULL=$(cat /sys/devices/system/cpu/nohz_full 2>/dev/null)
[ "$NOHZ_FULL" = "(null)" ] && NOHZ_FULL=""
declare -A IS_ISOLATED=()
for cpu in $(expand_cpus "$ISOLATED"); do IS_ISOLATED[$cpu]=1; done

param() {  # value of a kernel parameter, or "-"
    local value
    value=$(grep -oE " $1=[^ ]*" <<< "$CMDLINE" | tail -n 1)
    value=${value#*=}
    echo "${value:--}"
}

# State of a unit in one word. A oneshot service without RemainAfterExit
# (auto-pin-audio) is "inactive" once it has run, and a unit whose
# ConditionKernelCommandLine failed (irqbalance in experiment mode) is
# "inactive" too, so tell those apart.
unit_state() {
    local key value load="" active="" result="" cond="" cond_ts=0 exit_ts=0
    while IFS='=' read -r key value; do
        case "$key" in
            LoadState) load=$value ;;
            ActiveState) active=$value ;;
            Result) result=$value ;;
            ConditionResult) cond=$value ;;
            ConditionTimestampMonotonic) cond_ts=${value:-0} ;;
            ExecMainExitTimestampMonotonic) exit_ts=${value:-0} ;;
        esac
    done < <(systemctl show -p LoadState -p ActiveState -p Result -p ConditionResult \
                 -p ConditionTimestampMonotonic -p ExecMainExitTimestampMonotonic "$1" 2>/dev/null)

    if [ -z "$load" ]; then
        echo unknown
    elif [ "$load" = not-found ]; then
        echo "not installed"
    elif [ "$active" = inactive ] && [ "$cond_ts" != 0 ] && [ "$cond" = no ]; then
        echo skipped
    elif [ "$active" = inactive ] && [ "$exit_ts" != 0 ] && [ "$result" = success ]; then
        echo "done"
    else
        echo "$active"
    fi
}

# User space processes that may run on an isolated CPU and on other CPUs
# too: "COUNT NAME, NAME, NAME". A process limited to isolated CPUs only
# (OpenSesame, pinned on purpose) does not count; kernel threads neither.
leaking_processes() {
    grep -H -E '^(Name|PPid|Cpus_allowed_list):' /proc/[0-9]*/status 2>/dev/null |
        awk -v iso="$ISOLATED" '
            function expand(list, set,    parts, n, i, r, c) {
                n = split(list, parts, ",")
                for (i = 1; i <= n; i++) {
                    if (split(parts[i], r, "-") == 2) {
                        for (c = r[1] + 0; c <= r[2] + 0; c++) set[c] = 1
                    } else if (parts[i] != "") {
                        set[parts[i] + 0] = 1
                    }
                }
            }
            BEGIN { expand(iso, isolated) }
            {
                split($0, f, ":")
                value = $0
                sub(/^[^:]*:[^:]*:[ \t]*/, "", value)
                if (f[2] == "Name") name = value
                else if (f[2] == "PPid") ppid = value
                else if (f[2] == "Cpus_allowed_list" && ppid != 0 && ppid != 2) {
                    split("", cpus)
                    expand(value, cpus)
                    on_isolated = on_other = 0
                    for (c in cpus) { if ((c + 0) in isolated) on_isolated = 1; else on_other = 1 }
                    if (on_isolated && on_other && ++count <= 3)
                        names = names (names == "" ? "" : ", ") name
                }
            }
            END { print count + 0, names }'
}

settings() {
    local warn=() mode=normal threaded=no unit w leaks cpu default_irq
    default_irq=$(mask_to_cpus "$(cat /proc/irq/default_smp_affinity 2>/dev/null)")
    [[ $CMDLINE == *" experiment_mode=1 "* ]] && mode=experiment
    if [[ $(uname -v) == *PREEMPT_RT* ]]; then
        threaded="yes (PREEMPT_RT)"
    elif [[ $CMDLINE == *" threadirqs "* ]]; then
        threaded="yes (threadirqs)"
    fi

    echo "${BOLD}Mode:${RESET} $mode    ${BOLD}Kernel:${RESET} $(uname -r)    ${BOLD}Threaded IRQs:${RESET} $threaded"
    echo "${BOLD}Isolated (isolcpus):${RESET} ${ISOLATED:--}    ${BOLD}nohz_full:${RESET} ${NOHZ_FULL:--}    ${BOLD}New IRQs on:${RESET} $(compress_cpus "$default_irq") (irqaffinity=$(param irqaffinity))"
    for unit in irqbalance rtirq auto-pin-audio experiment-mode-cpus; do
        printf '%s%s:%s %s  ' "$BOLD" "$unit" "$RESET" "$(unit_state "$unit.service")"
    done
    echo

    if [ -n "$ISOLATED" ] && systemctl is-active --quiet irqbalance.service 2>/dev/null; then
        warn+=("irqbalance runs and moves pinned IRQs off the isolated CPUs")
    fi
    if [[ $CMDLINE == *" nohz_full="* ]] && [ -z "$NOHZ_FULL" ]; then
        warn+=("nohz_full= is set but not active: kernel without CONFIG_NO_HZ_FULL?")
    fi
    if [ "$mode" = experiment ] && [ "$threaded" = no ]; then
        warn+=("no threaded IRQs, so rtirq has no IRQ threads to prioritize")
    fi
    for cpu in $default_irq; do
        if [ -n "${IS_ISOLATED[$cpu]:-}" ]; then
            warn+=("new IRQs may start on the isolated CPUs (/proc/irq/default_smp_affinity): experiment-mode-cpus.service not active?")
            break
        fi
    done
    if [ -n "$ISOLATED" ]; then
        leaks=$(leaking_processes)
        if [ "${leaks%% *}" != 0 ]; then
            warn+=("${leaks%% *} processes may also run on the isolated CPUs (${leaks#* }, ...): experiment-mode-cpus.service not active, or started after the login?")
        fi
    fi
    for w in "${warn[@]}"; do echo "${RED}Warning:${RESET} $w"; done
}

# IRQs whose (effective) affinity includes an isolated CPU.
isolated_irqs() {
    local dir irq cpus cpu name list=""
    for dir in /proc/irq/[0-9]*; do
        irq=${dir##*/}
        cpus=$(cat "$dir/effective_affinity_list" 2>/dev/null || cat "$dir/smp_affinity_list" 2>/dev/null)
        for cpu in $(expand_cpus "$cpus"); do
            if [ -n "${IS_ISOLATED[$cpu]:-}" ]; then
                name=$(awk -v irq="$irq:" '$1 == irq { print $NF }' /proc/interrupts)
                [ -n "$name" ] && list+="  IRQ $irq ($name) -> CPU $cpus"$'\n'
                break
            fi
        done
    done
    echo "${BOLD}IRQs on isolated CPUs:${RESET} ${list:+$'\n'}${list:-none}"
}

# --- Counters ---

# One line per CPU: cpu busy total devirq loc timer rcu net_rx block
sample() {
    awk '
        FILENAME == "/proc/stat" && /^cpu[0-9]+ / {
            cpu = substr($1, 4); total = 0
            for (i = 2; i <= 9; i++) total += $i     # user .. steal
            busy[cpu] = total - $5 - $6; tot[cpu] = total; n = cpu + 1
        }
        FILENAME == "/proc/interrupts" {
            if (FNR == 1) { ncol = NF; next }
            label = $1; sub(":", "", label)
            for (c = 0; c < ncol; c++) {
                if (label ~ /^[0-9]+$/) dev[c] += $(c + 2)
                else if (label == "LOC") loc[c] = $(c + 2)
            }
        }
        FILENAME == "/proc/softirqs" {
            if (FNR == 1) next
            label = $1; sub(":", "", label)
            for (c = 0; c < NF - 1; c++) soft[label, c] = $(c + 2)
        }
        END {
            for (c = 0; c < n; c++)
                print c, busy[c], tot[c], dev[c] + 0, loc[c] + 0, soft["TIMER", c] + 0,
                      soft["RCU", c] + 0, soft["NET_RX", c] + 0, soft["BLOCK", c] + 0
        }' /proc/stat /proc/interrupts /proc/softirqs
}

# Bars with a green-to-red gradient, made once.
BARS=("")
for ((i = 1; i <= BAR_WIDTH; i++)); do
    pct=$((i * 100 / BAR_WIDTH))
    if [ -n "$RESET" ]; then
        if ((pct <= 50)); then r=$((255 * pct / 50)) g=255; else r=255 g=$((255 - 255 * (pct - 50) / 50)); fi
        BARS[i]="${BARS[i - 1]}"$'\e[38;2;'"$r;$g;0m#"
    else
        BARS[i]="${BARS[i - 1]}#"
    fi
done

table() {
    local -a now prev
    local cpu busy total line color label dt i
    local -A old=()
    while read -r line; do old[${line%% *}]=$line; done <<< "$1"
    dt=$3

    printf "%s%-6s %5s %8s %8s %8s %8s %8s %8s%s\n" "$BOLD" CPU Load IRQ/s LOC/s TIMER/s RCU/s NET_RX/s BLOCK/s "$RESET"
    while read -r line; do
        read -ra now <<< "$line"
        read -ra prev <<< "${old[${now[0]}]}"
        cpu=${now[0]}
        total=$((now[2] - prev[2]))
        busy=0
        ((total > 0)) && busy=$((100 * (now[1] - prev[1]) / total))
        color=$GREEN label=CPU$cpu
        if [ -n "${IS_ISOLATED[$cpu]:-}" ]; then
            color=$YELLOW label="CPU$cpu*"
        elif ((busy >= ABS_THRESHOLD)); then
            color=$RED
        fi
        printf "%s%-6s%s %4d%%" "$color" "$label" "$RESET" "$busy"
        for i in 3 4 5 6 7 8; do
            printf " %8d" $(((now[i] - prev[i]) / dt))
        done
        printf " |%s%s\n" "${BARS[busy * BAR_WIDTH / 100]}" "$RESET"
    done <<< "$2"
    echo "${YELLOW}CPU*${RESET} = isolated   ${RED}red${RESET} = normal CPU at ${ABS_THRESHOLD}% load or more   (per second, over ${dt}s)"
}

prev_sample=$(sample)
while true; do
    sleep "$INTERVAL"
    now_sample=$(sample)
    frame="$(settings)"$'\n'
    [ -n "$ISOLATED" ] && frame+="$(isolated_irqs)"$'\n'
    frame+=$'\n'"$(table "$prev_sample" "$now_sample" "$INTERVAL")"
    printf '%s%s\n' "$CLEAR" "$frame"
    [ "$ONCE" = 1 ] && exit 0
    prev_sample=$now_sample
done
