#!/bin/bash
# Copyright (C) 2025-2026 Bob Rosbag <mail@bobrosbag.nl>
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Pins the IRQs of all sound cards to the isolated CPUs (isolcpus=), one
# CPU per IRQ in turn. For a USB audio interface that is the IRQ of its USB
# host controller, which it shares with the other devices on that controller.
#
# Run by auto-pin-audio.service in experiment mode, at boot and whenever a
# sound card is added. Output: journalctl -u auto-pin-audio.service
# irqbalance would move the IRQs away again; it does not run in experiment
# mode (irqbalance.service.d/disable-experiment.conf).

set -u

case "${1:-}" in
    "") ;;
    -h|--help) echo "Usage: ${0##*/}   (no options; run by auto-pin-audio.service)"; exit 0 ;;
    *) echo "Usage: ${0##*/}   (no options)" >&2; exit 2 ;;
esac

isolated=$(cat /sys/devices/system/cpu/isolated 2>/dev/null)
if [ -z "$isolated" ]; then
    echo "No isolated CPUs (isolcpus=), nothing to pin."
    exit 0
fi

# "2-4,7" -> "2 3 4 7"
expand_cpus() {
    local part cpu
    local -a parts out=()
    IFS=, read -ra parts <<< "$1"
    for part in "${parts[@]}"; do
        if [[ $part =~ ^([0-9]+)-([0-9]+)$ ]]; then
            for ((cpu = BASH_REMATCH[1]; cpu <= BASH_REMATCH[2]; cpu++)); do
                out+=("$cpu")
            done
        else
            out+=("$part")
        fi
    done
    echo "${out[*]}"
}

# IRQs a driver has set up for a PCI device: its MSI/MSI-X vectors, else its
# legacy IRQ. A device can reserve more vectors than its driver requests
# (xhci_hcd: 8, of which 1 in use); those have no /proc/irq/N.
pci_irqs() {
    local dev="/sys/bus/pci/devices/$1" irq irqs
    if [ -n "$(ls -A "$dev/msi_irqs" 2>/dev/null)" ]; then
        irqs=$(ls "$dev/msi_irqs")
    else
        irqs=$(cat "$dev/irq" 2>/dev/null)
    fi
    for irq in $irqs; do
        if [ "$irq" != 0 ] && [ -d "/proc/irq/$irq" ]; then echo "$irq"; fi
    done
}

read -ra cpus <<< "$(expand_cpus "$isolated")"

# IRQ -> names of the sound cards that use it
declare -A cards=()
for card in /sys/class/sound/card[0-9]*; do
    [ -e "$card/device" ] || continue
    # The nearest PCI device above the card: the sound card itself, or the
    # USB host controller of a USB audio interface.
    pci=$(readlink -f "$card/device" | grep -oE '[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-9a-f]' | tail -n 1)
    [ -n "$pci" ] || continue
    name=$(cat "$card/id" 2>/dev/null || basename "$card")
    for irq in $(pci_irqs "$pci"); do
        cards[$irq]="${cards[$irq]:+${cards[$irq]} }$name"
    done
done

if [ ${#cards[@]} -eq 0 ]; then
    echo "No sound card IRQs found."
    exit 0
fi

echo "Isolated CPUs: $isolated"
printf '%-6s %-24s %s\n' IRQ "Sound card" CPU
i=0
for irq in $(printf '%s\n' "${!cards[@]}" | sort -n); do
    cpu=${cpus[i % ${#cpus[@]}]}
    if echo "$cpu" > "/proc/irq/$irq/smp_affinity_list" 2>/dev/null; then
        result=$cpu
        i=$((i + 1))
    else
        # Managed IRQs are placed by the kernel and cannot be moved.
        result="unchanged ($(cat "/proc/irq/$irq/smp_affinity_list" 2>/dev/null))"
    fi
    printf '%-6s %-24s %s\n' "$irq" "${cards[$irq]}" "$result"
done
