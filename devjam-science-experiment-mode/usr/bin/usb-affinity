#!/bin/bash
# Copyright (C) 2025-2026 Bob Rosbag <mail@bobrosbag.nl>
# SPDX-License-Identifier: GPL-3.0-or-later
#
# USB host controllers with their IRQs, the CPUs those IRQs may run on and
# the devices behind each controller; optionally pins a controller's IRQs.
# A USB device has no IRQ of its own: it uses the IRQ(s) of its controller.

set -u

usage() {
    cat <<EOF
Usage: ${0##*/}                 show the USB controllers, IRQs and devices
       ${0##*/} usbN CPU-LIST   pin the IRQs of the controller of bus usbN
                                to CPU-LIST (e.g. usb1 2,3), needs root
The pinning lasts until reboot. irqbalance, when it runs, moves it again.
EOF
}

# PCI address of the controller of a bus (usb1 -> 0000:00:14.0)
controller_of() {
    local path
    path=$(readlink -f "/sys/bus/usb/devices/$1") || return 1
    basename "$(dirname "$path")"
}

# IRQs of a PCI device: its MSI/MSI-X vectors, else its legacy IRQ.
pci_irqs() {
    local dev="/sys/bus/pci/devices/$1"
    if [ -n "$(ls -A "$dev/msi_irqs" 2>/dev/null)" ]; then
        ls "$dev/msi_irqs" | sort -n
    elif [ "$(cat "$dev/irq" 2>/dev/null || echo 0)" != 0 ]; then
        cat "$dev/irq"
    fi
}

irq_info() {
    local irq="$1" counts
    counts=$(awk -v irq="$irq:" '
        NR == 1 { ncpu = NF; next }
        $1 == irq { for (c = 0; c < ncpu; c++) if ($(c + 2) > 0) printf " CPU%d=%s", c, $(c + 2) }' /proc/interrupts)
    echo "  IRQ $irq: allowed CPUs $(cat "/proc/irq/$irq/smp_affinity_list" 2>/dev/null)," \
        "runs on $(cat "/proc/irq/$irq/effective_affinity_list" 2>/dev/null || echo "?")"
    echo "    interrupts:${counts:- none}"
}

# Prints a device and its children; the drivers of its interfaces show
# what it is (snd-usb-audio, usbhid, ftdi_sio, ...).
device_tree() {
    local dev="$1" indent="$2" child drivers="" intf driver
    for intf in "$dev"/*:*; do
        [ -e "$intf/driver" ] || continue
        driver=$(basename "$(readlink "$intf/driver")")
        [[ " $drivers " == *" $driver "* ]] || drivers+=" $driver"
    done
    printf '%s%s: %s %s [%s Mb/s]%s\n' "$indent" "$(basename "$dev")" \
        "$(cat "$dev/manufacturer" 2>/dev/null)" "$(cat "$dev/product" 2>/dev/null)" \
        "$(cat "$dev/speed" 2>/dev/null)" "${drivers:+ (${drivers# })}"
    for child in "$dev"/[0-9]*-*; do
        [[ $(basename "$child") =~ ^[0-9]+-[0-9.]+$ ]] && device_tree "$child" "$indent  "
    done
}

show() {
    local bus pci irq child
    local -A buses=()
    for bus in /sys/bus/usb/devices/usb*; do
        [ -e "$bus" ] || continue
        pci=$(controller_of "$(basename "$bus")")
        buses[$pci]+=" $(basename "$bus")"
    done
    for pci in $(printf '%s\n' "${!buses[@]}" | sort); do
        echo "Controller $pci ($(basename "$(readlink "/sys/bus/pci/devices/$pci/driver" 2>/dev/null)")), buses:${buses[$pci]}"
        for irq in $(pci_irqs "$pci"); do irq_info "$irq"; done
        for bus in ${buses[$pci]}; do
            for child in /sys/bus/usb/devices/"$bus"/[0-9]*-*; do
                [[ $(basename "$child") =~ ^[0-9]+-[0-9.]+$ ]] && device_tree "$child" "    "
            done
        done
        echo
    done
}

pin() {
    local bus="$1" cpus="$2" pci irq
    if [[ ! $cpus =~ ^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$ ]]; then
        echo "Invalid CPU list: $cpus" >&2
        exit 2
    fi
    if [ ! -e "/sys/bus/usb/devices/$bus" ] || [[ $bus != usb* ]]; then
        echo "No USB bus $bus (see ${0##*/} without arguments)" >&2
        exit 2
    fi
    pci=$(controller_of "$bus")
    for irq in $(pci_irqs "$pci"); do
        echo "Pinning IRQ $irq of controller $pci ($bus) to CPUs $cpus"
        if [ "$EUID" -eq 0 ]; then
            echo "$cpus" > "/proc/irq/$irq/smp_affinity_list"
        else
            echo "$cpus" | sudo tee "/proc/irq/$irq/smp_affinity_list" > /dev/null
        fi || echo "  failed (managed IRQ, or a CPU that does not exist?)"
    done
    if systemctl is-active --quiet irqbalance.service 2>/dev/null; then
        echo "Note: irqbalance runs and may move these IRQs again."
    fi
    echo
}

case "$#:${1:-}" in
    0:) show ;;
    1:-h|1:--help) usage ;;
    2:usb*) pin "$1" "$2"; show ;;
    *) usage >&2; exit 2 ;;
esac
