[Unit]
Description=Keep services and user sessions off the isolated CPUs (experiment mode)
Documentation=file:///usr/share/doc/devjam-science-experiment-mode/README.md
# Only in experiment mode (GRUB entries with experiment_mode=1).
ConditionKernelCommandLine=experiment_mode=1
# The user service managers must start with the limited CPUs.
Before=systemd-user-sessions.service

[Service]
# The limits are runtime settings: they are gone after a reboot. To lift
# them while the system runs: /usr/lib/devjam/experiment-mode/confine-cpus --undo
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/devjam/experiment-mode/confine-cpus

[Install]
WantedBy=multi-user.target
