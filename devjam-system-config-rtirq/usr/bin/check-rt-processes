#!/bin/bash
# Copyright (C) 2025-2026 Bob Rosbag <mail@bobrosbag.nl>
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Lists the real-time threads (SCHED_FIFO = FF, SCHED_RR = RR,
# SCHED_DEADLINE = DLN), highest priority first: IRQ threads (rtirq),
# PipeWire, OpenSesame (RT service) and so on. PSR is the CPU the thread
# last ran on.

usage() {
    echo "Usage: ${0##*/} [-1] [SECONDS]   (-1: list once; default: refresh every 0.5 s)"
}

case "${1:-0.5}" in
    -1|--once)
        ps -eLo pid,tid,cls,rtprio,psr,comm --sort=-rtprio |
            awk 'NR == 1 || $3 ~ /^(FF|RR|DLN)$/'
        ;;
    -h|--help) usage ;;
    *[!0-9.]*) usage >&2; exit 2 ;;
    *) exec watch -n "${1:-0.5}" "$(printf '%q' "$0") -1" ;;
esac
