#!/bin/bash
# Copyright (C) 2025-2026 Bob Rosbag <mail@bobrosbag.nl>
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Shows what rtirq did: the real-time priority of the IRQ threads of the
# drivers in RTIRQ_NAME_LIST (/etc/rtirq.conf), and the CPUs those IRQs may
# run on. rtirq only sets priorities (SCHED_FIFO), not CPUs. Without rtirq
# the kernel runs IRQ threads at SCHED_FIFO 50 and the secondary threads of
# forced-threaded handlers (irq/N-s-NAME) at 49 (sched_set_fifo and
# sched_set_fifo_secondary in kernel/sched/syscalls.c); rtirq sets the
# threads of its drivers to 51-95 and, with RTIRQ_RESET_ALL, all others to 50.

set -u

case "${1:-}" in
    "") ;;
    -h|--help) echo "Usage: ${0##*/}   (shows the IRQ thread priorities rtirq set)"; exit 0 ;;
    *) echo "Usage: ${0##*/}   (no options)" >&2; exit 2 ;;
esac

RTIRQ_NAME_LIST=""
# shellcheck disable=SC1091
[ -r /etc/rtirq.conf ] && . /etc/rtirq.conf

echo "rtirq.service: $(systemctl is-enabled rtirq.service 2>/dev/null), $(systemctl is-active rtirq.service 2>/dev/null)"
if [[ $(uname -v) == *PREEMPT_RT* ]]; then
    echo "Threaded IRQs: yes (PREEMPT_RT kernel)"
elif [[ " $(cat /proc/cmdline) " == *" threadirqs "* ]]; then
    echo "Threaded IRQs: yes (threadirqs)"
else
    echo "Threaded IRQs: no -- rtirq needs a PREEMPT_RT kernel or the kernel parameter threadirqs"
fi
echo "RTIRQ_NAME_LIST: $RTIRQ_NAME_LIST"
echo

# The names as rtirq matches them against /proc/interrupts: usb stands for
# the USB host controllers, snd-usb for the controller of a USB sound card
# (which usb already covers).
patterns=()
for name in $RTIRQ_NAME_LIST; do
    case "$name" in
        usb) patterns+=("[eoux]hci.hcd") ;;
        snd-usb) ;;
        *) patterns+=("$name") ;;
    esac
done
match=$(IFS='|'; echo "${patterns[*]}")

# IRQ threads that match RTIRQ_NAME_LIST, or that run above 50 (raised).
printf '%-5s %-6s %4s  %-9s %s\n' IRQ Policy Prio "IRQ CPUs" "Device"
ps -eLo cls=,rtprio=,comm= | while read -r cls prio comm; do
    [[ $comm == irq/[0-9]* ]] || continue
    irq=${comm#irq/}
    irq=${irq%%-*}
    line=$(grep -E "^ *$irq:" /proc/interrupts)
    if [ "$prio" -gt 50 ] 2>/dev/null || { [ -n "$match" ] && grep -qE "$match" <<< "$line"; }; then
        printf '%-5s %-6s %4s  %-9s %s\n' "$irq" "$cls" "$prio" \
            "$(cat "/proc/irq/$irq/smp_affinity_list" 2>/dev/null)" "${comm#irq/"$irq"-}"
    fi
done | sort -k3,3nr -k1,1n
