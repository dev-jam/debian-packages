#!/bin/sh
set -e

# /etc/rtirq.conf is a conffile of the rtirq package, and rtirq reads no
# other path. To use the lab configuration without modifying rtirq's
# conffile, it is diverted to /etc/rtirq.conf.rtirq and this package ships
# /etc/rtirq.conf as a symlink to its own conffile /etc/rtirq.conf.devjam.
#
# Up to version 1.46-1 the configuration was part of
# devjam-science-experiment-mode-rtirq, which owns the diversion on such
# systems. That diversion is taken over as it is: rtirq's file already
# sits at /etc/rtirq.conf.rtirq, so nothing is renamed.

old_package=devjam-science-experiment-mode-rtirq

case "$1" in
    install|upgrade)
        owner=$(dpkg-divert --listpackage /etc/rtirq.conf)
        if [ "$owner" = "$old_package" ]; then
            dpkg-divert --package "$old_package" --no-rename \
                --remove /etc/rtirq.conf
            dpkg-divert --package devjam-system-config-rtirq --no-rename \
                --add --divert /etc/rtirq.conf.rtirq /etc/rtirq.conf
        else
            # devjam-science-experiment-mode-rtirq before 1.45-1 moved
            # rtirq's file to /etc/rtirq.conf.org and copied the lab
            # configuration over /etc/rtirq.conf. Put rtirq's own file
            # back first, so that it is the one that gets diverted.
            old_version=$(dpkg-query -W -f='${Version}' "$old_package" 2>/dev/null || true)
            if [ -n "$old_version" ] && dpkg --compare-versions "$old_version" lt 1.45-1~ \
                && [ -f /etc/rtirq.conf.org ]; then
                mv -f /etc/rtirq.conf.org /etc/rtirq.conf
            fi

            dpkg-divert --package devjam-system-config-rtirq \
                --add --rename --divert /etc/rtirq.conf.rtirq /etc/rtirq.conf

            # When rtirq is unpacked in the same dpkg run but not yet
            # configured, its new conffile still waits as
            # /etc/rtirq.conf.dpkg-new, where dpkg would also unpack this
            # package's /etc/rtirq.conf symlink. Move it to the diverted
            # name, where dpkg looks for it when rtirq is configured.
            if [ -f /etc/rtirq.conf.dpkg-new ] && [ ! -L /etc/rtirq.conf.dpkg-new ] \
                && [ ! -e /etc/rtirq.conf.rtirq.dpkg-new ]; then
                mv /etc/rtirq.conf.dpkg-new /etc/rtirq.conf.rtirq.dpkg-new
            fi
        fi
        ;;
esac

exit 0
