# IRQ priority order optimized for deterministic human-EEG, buttonbox and audio visual timing:
#   1. snd     -> Primary audio interface (HDA Intel on Prio 90)
#   2. snd-usb -> Secondary USB audio interfaces (MOTU M2 on Prio 85)
#   3. usb     -> USB Host Controllers (XHCI/EHCI for FT232 buttonbox, mouse, keyboard on Prio 80)
#   4. parport -> Parallel port TTL triggers for EEG (Prio 75)
#   5. i915    -> Intel GPU interrupts (Prio 70)

RTIRQ_NAME_LIST="snd snd-usb usb parport i915"
RTIRQ_PRIO_HIGH=90
RTIRQ_PRIO_DECR=5
RTIRQ_PRIO_LOW=51
RTIRQ_RESET_ALL=yes
RTIRQ_NON_THREADED="rtc0"
