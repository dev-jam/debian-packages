#!/bin/bash
# Copyright (C) 2021-2026 Bob Rosbag <mail@bobrosbag.nl>
# SPDX-License-Identifier: GPL-3.0-or-later

# Isolated-build replacement for the manual "dch ... && dpkg-buildpackage
# -us -uc -b" workflow, for any package that has a debian/ folder -- not
# specific to backports. Builds via sbuild's unshare backend instead of
# directly on the host.
#
# Usage:
#   cd path/to/package-with-debian-folder
#   sbuild-local [--dist=SUITE] [--nocheck | --nocheck-profile]
#                [--allow-unstable=PKG[,PKG...]] [--extra-package-dir=DIR]
#                [--output-dir=DIR]
#
# Output: by default everything lands next to the source tree (../), like
# dpkg-buildpackage. With --output-dir=DIR (or SBUILD_LOCAL_OUTPUT_DIR=DIR
# in the environment) the build artifacts (.deb, .changes, .buildinfo,
# build log) go to DIR, and after a successful build the source package
# files of this version (.dsc, .debian.tar.*, .orig.tar.*) are moved from
# ../ to DIR as well. The orig tarball has to sit in ../ during the build:
# dpkg-source looks for it next to the source tree.
#
# Requires in ~/.sbuildrc (same as build-bpo):
#   $chroot_mode = 'unshare';
#   $clean_source = 0;
#
# NOTE on --nocheck vs --nocheck-profile: these are two different Debian
# mechanisms that share a name.
#   --nocheck          sets DEB_BUILD_OPTIONS=nocheck: debian/rules and
#                      dh_auto_test skip the test suite, but every
#                      build-dep (including test-only ones) is installed.
#   --nocheck-profile  does the above AND sets the nocheck build profile:
#                      build-deps marked <!nocheck> are not installed.
#                      The Build Profile spec requires the profile to be
#                      paired with DEB_BUILD_OPTIONS=nocheck, so this
#                      option always sets both.
# Use --nocheck when tests fail; use --nocheck-profile only when a
# test-only build-dep can't be satisfied on the target suite. The profile
# can break packages whose debian/rules still uses a <!nocheck> dep
# outside the test step (e.g. xvfb-run needing xauth in xlibre-server).
#
# DEB_BUILD_OPTIONS is exported to sbuild's environment. sbuild's default
# environment_filter is expected to pass DEB_* variables through to the
# build, but check the environment section of the build log once. If it
# is missing there, set it via $build_environment in ~/.sbuildrc instead.
#
# NOTE on --allow-unstable: this pins unstable to -1 (never installable)
# except for the named source package(s) (via src:name, which also covers
# their binaries), pinned high. The preferences file is shipped to the
# chroot as a base64 blob via --chroot-setup-commands and decoded there.
# ("apt-get install -t unstable" was tried first and rejected: -t sets
# the candidate preference for the whole transaction, not just the named
# package, and pulled in a large chunk of unstable -- glibc, openssl,
# python3 -- instead of just debhelper. A plain multi-line printf with
# embedded \n was tried next and also broke: "Unable to parse package
# file ... (1)" -- and a bare %s in a hook command turned out to be a
# reserved sbuild percent-escape token, silently replaced with
# "bash -i </dev/tty...". base64 output contains neither, so it survives
# intact.)

set -euo pipefail

# Distribution to build against. Override with --dist=SUITE if the
# package's changelog targets something other than trixie.
DIST="trixie"

# 0 = run the test suite (default, matches dpkg-buildpackage)
# 1 = --nocheck:         DEB_BUILD_OPTIONS=nocheck only
# 2 = --nocheck-profile: DEB_BUILD_OPTIONS=nocheck plus the nocheck profile
NOCHECK=0

# Comma-separated source package names (e.g. debhelper) to allow from
# unstable, for when debian/control needs a build-tool version that only
# exists there (e.g. debhelper-compat = 14 on trixie, which only ships
# 13.x). Pinned via src:name, which covers every binary built from that
# source. unstable itself is pinned to -1 (never installable) except for
# these, pinned high -- so nothing else can leak in from it. This is safe
# for actual *build tools* (debhelper, dh-sequence-*, etc.): they never
# appear in the built .deb's own Depends:, unlike a library.
ALLOW_UNSTABLE=""

# Directory of extra .deb files to make available for build-dep
# resolution, via sbuild's own --extra-package (one flag per .deb) --
# e.g. a locally-built dependency you don't want to publish anywhere.
EXTRA_PACKAGE_DIR=""

# Directory for the build artifacts and, after the build, the source
# package files; empty = the parent of the source tree (see above).
OUTPUT_DIR="${SBUILD_LOCAL_OUTPUT_DIR:-}"

usage() {
    echo "Usage: $0 [--dist=SUITE] [--nocheck | --nocheck-profile] [--allow-unstable=PKG[,PKG...]] [--extra-package-dir=DIR] [--output-dir=DIR]"
}

command -v sbuild >/dev/null || { echo "Error: sbuild not installed" >&2; exit 1; }
command -v base64 >/dev/null || { echo "Error: base64 not installed" >&2; exit 1; }
command -v dpkg-parsechangelog >/dev/null || { echo "Error: dpkg-parsechangelog not installed" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dist=*)
            DIST="${1#*=}"
            shift
            ;;
        --nocheck)
            # Never downgrade an already requested --nocheck-profile
            [ "$NOCHECK" -lt 1 ] && NOCHECK=1
            shift
            ;;
        --nocheck-profile)
            NOCHECK=2
            shift
            ;;
        --allow-unstable=*)
            ALLOW_UNSTABLE="${1#*=}"
            shift
            ;;
        --extra-package-dir=*)
            EXTRA_PACKAGE_DIR="${1#*=}"
            shift
            ;;
        --output-dir=*)
            OUTPUT_DIR="${1#*=}"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Error: Unknown option $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

[ -f debian/changelog ] || {
    echo "Error: no debian/changelog here. Run this from the package's source directory." >&2
    exit 1
}

src_dir="$PWD"
# Match dpkg-buildpackage's own convention: output lands one directory
# above the source tree, not inside it.
build_dir="$(dirname "$src_dir")"
# Where sbuild writes the artifacts: the parent of the source tree, or
# --output-dir (made absolute: sbuild runs from another directory)
if [ -n "$OUTPUT_DIR" ]; then
    mkdir -p "$OUTPUT_DIR"
    out_dir="$(cd "$OUTPUT_DIR" && pwd)"
else
    out_dir="$build_dir"
fi
nproc_count=$(nproc)

# Quilt-format (3.0 (quilt), the common case) source trees need the
# original upstream tarball sitting next to the source dir
# (../<pkg>_<version>.orig.tar.*) -- dpkg-source refuses to build without
# it. A source tree that only came from a git checkout (rather than
# apt source, which fetches this automatically) usually lacks it. If
# debian/watch exists, try uscan to fetch it before that failure happens.
pkg_name=$(dpkg-parsechangelog -S Source)
shopt -s nullglob
upstream_version=$(dpkg-parsechangelog -S Version | sed -e 's/^[0-9]*://' -e 's/-[^-]*$//')
orig_tarballs=(../"${pkg_name}"_"${upstream_version}".orig.tar.*)
shopt -u nullglob
if [ "${#orig_tarballs[@]}" -eq 0 ] && [ -f debian/watch ]; then
    if command -v uscan >/dev/null; then
        echo "No upstream orig tarball next to the source tree -- trying uscan --download-current-version..."
        uscan --download-current-version || echo "Warning: uscan didn't produce one; build may fail below." >&2
    else
        echo "Warning: no orig tarball and uscan isn't installed -- build will likely fail." >&2
    fi
fi

sbuild_args=(-d "$DIST" -j"$nproc_count" --build-dir="$out_dir")

# Skip the test suite; add the profile only on explicit request
if [ "$NOCHECK" -ge 1 ]; then
    case " ${DEB_BUILD_OPTIONS:-} " in
        *" nocheck "*) ;;
        *) export DEB_BUILD_OPTIONS="${DEB_BUILD_OPTIONS:+$DEB_BUILD_OPTIONS }nocheck" ;;
    esac
fi
[ "$NOCHECK" -eq 2 ] && sbuild_args+=(--profiles=nocheck)

if [ -n "$EXTRA_PACKAGE_DIR" ]; then
    shopt -s nullglob
    extra_debs=("$EXTRA_PACKAGE_DIR"/*.deb)
    shopt -u nullglob
    if [ "${#extra_debs[@]}" -eq 0 ]; then
        echo "Warning: no .deb files found in $EXTRA_PACKAGE_DIR" >&2
    fi
    for deb in "${extra_debs[@]}"; do
        sbuild_args+=(--extra-package="$deb")
    done
fi

if [ -n "$ALLOW_UNSTABLE" ]; then
    pin_file="/etc/apt/preferences.d/99-unstable-allowlist"
    # Pin by source package (src:name) rather than listing binaries --
    # apt_preferences resolves this to every binary built from that
    # source (e.g. src:debhelper covers both debhelper and
    # libdebhelper-perl), so a version-locked sibling dependency like
    # "debhelper Depends: libdebhelper-perl (= 14.5)" can't get stuck
    # half-pinned because a sibling binary was left off the list.
    src_pkglist=""
    for pkg in ${ALLOW_UNSTABLE//,/ }; do
        src_pkglist="${src_pkglist}src:${pkg} "
    done
    src_pkglist="${src_pkglist% }"

    # Add the unstable source ourselves (chroot-setup-commands runs
    # before sbuild wires up --extra-repository sources, so relying on
    # that gave "unstable ... not available in the sources"). The
    # trailing "&& echo ... && cat ..." isn't needed for the write
    # itself -- it's there purely so the sbuild log's output for this
    # hook shows the file it just wrote instead of just
    # "I: Finished running '...'".
    sbuild_args+=(--chroot-setup-commands="sh -c \"echo 'deb http://deb.debian.org/debian unstable main' > /etc/apt/sources.list.d/99-unstable.list && echo 'Added unstable apt source:' && echo && cat /etc/apt/sources.list.d/99-unstable.list && echo\"")

    # Pin unstable to -1 (never installable) except for exactly the
    # allow-listed packages, pinned high. NOT using "apt-get install
    # -t unstable" here: -t sets the candidate preference for the
    # whole transaction, not just the named package -- it pulled in a
    # large chunk of unstable (glibc, openssl, python3...) rather than
    # just debhelper.
    #
    # The preferences file is assembled here and shipped to the chroot
    # as a single base64 blob, decoded on the other side -- that part
    # has to stay a compact one-liner: an earlier attempt writing it
    # as plain multi-line text (one --chroot-setup-commands per line,
    # then a heredoc) either got mangled in transit or tripped
    # sbuild's own percent-escape preprocessing, which treats a bare
    # %s in a hook command as a hook token and silently replaces it
    # with "bash -i </dev/tty...". base64 output never contains a
    # literal "%", so it survives untouched.
    # As above, the "&& echo ... && cat ..." tail is just so the
    # actual preferences file shows up in the log's output section
    # rather than the log showing only the base64 blob and "Finished
    # running".
    pin_content=$(printf '%s\n' \
        "Package: *" "Pin: release a=unstable" "Pin-Priority: -1" "" \
        "Package: ${src_pkglist}" "Pin: release a=unstable" "Pin-Priority: 990")
    pin_content_b64=$(printf '%s' "$pin_content" | base64 -w0)

    sbuild_args+=(--chroot-setup-commands="sh -c \"echo ${pin_content_b64} | base64 -d > ${pin_file} && echo 'Wrote unstable apt pin preferences:' && echo && cat ${pin_file} && echo\"")
    sbuild_args+=(--chroot-setup-commands="apt-get update -qq")
fi

echo "Source:    $src_dir"
echo "Dist:      $DIST"
echo "Build-dir: $out_dir"
case "$NOCHECK" in
    1) echo "Nocheck:   tests skipped (DEB_BUILD_OPTIONS=$DEB_BUILD_OPTIONS), all build-deps installed" ;;
    2) echo "Nocheck:   tests skipped (DEB_BUILD_OPTIONS=$DEB_BUILD_OPTIONS) + nocheck profile (<!nocheck> build-deps dropped)" ;;
esac
[ -n "$ALLOW_UNSTABLE" ] && echo "From unstable (only): $ALLOW_UNSTABLE"
[ -n "$EXTRA_PACKAGE_DIR" ] && echo "Extra packages from: $EXTRA_PACKAGE_DIR (${#extra_debs[@]} .deb found)"

sbuild "${sbuild_args[@]}" .

# With --output-dir: also move the source package files of this version
# (dpkg-source writes them next to the source tree) to the output dir, so
# that everything of one build is in one place
if [ "$out_dir" != "$build_dir" ]; then
    full_version=$(dpkg-parsechangelog -S Version | sed -e 's/^[0-9]*://')
    shopt -s nullglob
    src_files=("$build_dir/${pkg_name}_${full_version}".dsc
               "$build_dir/${pkg_name}_${full_version}".debian.tar.*
               "$build_dir/${pkg_name}_${full_version}"_source.*
               "$build_dir/${pkg_name}_${upstream_version}".orig.tar.*)
    shopt -u nullglob
    if [ "${#src_files[@]}" -gt 0 ]; then
        mv -f -- "${src_files[@]}" "$out_dir"/
        echo "Moved to $out_dir:"
        printf '    %s\n' "${src_files[@]##*/}"
    fi
fi
