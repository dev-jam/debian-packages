#!/bin/bash
# Remux video files to MKV or MP4 format without re-encoding.
# Usage: to-video-container [--mkv|--mp4] <video_file1> [<video_file2> ...]
# Default output container is MKV (using mkvmerge) if no flag is specified.
set -euo pipefail

# Check for arguments
if [ $# -eq 0 ]; then
    echo "Usage: $0 [--mkv|--mp4] <video_file1> [<video_file2> ...]" >&2
    exit 1
fi

mode="mkv"

# Parse optional flag
case "$1" in
    --mkv)
        mode="mkv"
        shift
        ;;
    --mp4)
        mode="mp4"
        shift
        ;;
    --*)
        echo "Error: Unknown option '$1'. Use --mkv or --mp4." >&2
        exit 1
        ;;
esac

# Ensure at least one input file remains
if [ $# -eq 0 ]; then
    echo "Error: No input files specified." >&2
    exit 1
fi

# Verify required dependencies based on chosen mode
if [ "$mode" = "mkv" ]; then
    command -v mkvmerge >/dev/null || { echo "Error: mkvmerge not installed" >&2; exit 1; }
else
    command -v ffmpeg >/dev/null || { echo "Error: ffmpeg not installed" >&2; exit 1; }
fi

# Detect once whether a terminal is available for the overwrite prompt below.
# A bare `read` under `set -e` aborts the whole batch on EOF (e.g. run from
# cron or with stdin redirected) instead of just skipping the one conflict -
# so without a terminal, fall back to always skipping conflicting files.
interactive=1
{ [ -t 0 ] && [ -t 1 ]; } || interactive=0

success_count=0
error_count=0

# Process each input file
for input_file in "$@"; do
    # Check if file exists and is readable
    if [ ! -r "$input_file" ]; then
        echo "Error: '$input_file' does not exist or is not readable" >&2
        error_count=$((error_count + 1))
        continue
    fi

    # Warn if file extension seems unusual for a video file
    if [[ ! "$input_file" =~ \.(avi|mpeg|mpg|mp4|mkv|mov|wmv|flv|webm|ts|m2ts)$ ]]; then
        echo "Warning: '$input_file' may not be a supported video file" >&2
    fi

    # Generate output filename
    output_file="${input_file%.*}.${mode}"

    # Skip if input and output would be the same file
    if [ "$(readlink -f "$input_file")" = "$(readlink -f "$output_file")" ]; then
        echo "Skipping '$input_file': already in $mode container format." >&2
        error_count=$((error_count + 1))
        continue
    fi

    # Interactive overwrite prompt
    if [ -e "$output_file" ]; then
        if [ "$interactive" -eq 1 ]; then
            echo ""
            echo "'$output_file' already exists."
            read -r -p "Overwrite (o) / Skip (s) / Cancel entire batch (c)? " answer
            case "$answer" in
                o|O) : ;;
                s|S) continue ;;
                c|C) echo "Conversion cancelled."; exit 1 ;;
                *) echo "Unrecognised answer, skipping '$input_file'." >&2; continue ;;
            esac
        else
            echo "Skipping '$input_file': '$output_file' already exists (no terminal available to confirm)." >&2
            error_count=$((error_count + 1))
            continue
        fi
    fi

    # Check write permission in destination directory
    output_dir=$(dirname "$output_file")
    if [ ! -w "$output_dir" ]; then
        echo "Error: No write permission in '$output_dir'" >&2
        error_count=$((error_count + 1))
        continue
    fi

    # Write to a temp file first and rename into place, so a failed/interrupted
    # remux never leaves a partial file at the final path. Keep the real
    # extension on the temp file so mkvmerge/ffmpeg still infer the right muxer.
    tmp_file=$(mktemp --suffix=".${mode}" "${output_dir}/.tmp.XXXXXX") || {
        echo "Error: Failed to create temp file in '$output_dir'" >&2
        error_count=$((error_count + 1))
        continue
    }
    # mktemp creates files at mode 0600; restore the usual umask-based permissions
    chmod "$(printf '%o' $((0666 & ~$(umask))))" "$tmp_file"

    echo "Converting '$input_file' to '$output_file'..."

    ok=1
    if [ "$mode" = "mkv" ]; then
        # Remux using mkvmerge
        mkvmerge -o "$tmp_file" "$input_file" 2>/dev/null || ok=0
    else
        # Remux using ffmpeg (stream copy, no re-encoding)
        ffmpeg -y -i "$input_file" -c copy -movflags +faststart "$tmp_file" -loglevel error </dev/null || ok=0
    fi

    if [ "$ok" -eq 1 ] && mv -n "$tmp_file" "$output_file"; then
        echo "✅ Success: Created '$output_file'"
        echo ""
        success_count=$((success_count + 1))
    else
        echo "❌ Error: Failed to convert '$input_file'" >&2
        echo ""
        rm -f "$tmp_file"
        error_count=$((error_count + 1))
    fi
done

# Print summary
echo "Completed: $success_count file(s) converted, $error_count error(s)"
exit $(( error_count > 255 ? 255 : error_count ))
