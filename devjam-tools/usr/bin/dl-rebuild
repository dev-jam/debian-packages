#!/bin/sh

set -e

printf "\n"
printf "Rebuild live image...\n\n"

printf "\n"
printf "Cleaning binary environment...\n\n"

sudo lb clean --binary

printf "\n\n"
printf "Configuring build environment...\n\n"

lb config

printf "\n\n"
printf "Building live image...\n\n"

sudo lb build

printf "\n\n"
printf "Building done.\n\n"
