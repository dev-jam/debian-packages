#!/bin/sh
set -e

# Give /etc/rtirq.conf back to the rtirq package (see preinst). On
# abort-upgrade this is only needed when the old version did not divert.
case "$1" in
    remove|abort-install|disappear)
        remove_diversion=1
        ;;
    abort-upgrade)
        if dpkg --compare-versions "$2" lt 1.45-1~; then
            remove_diversion=1
        fi
        ;;
esac
if [ -n "${remove_diversion:-}" ]; then
    dpkg-divert --package devjam-science-experiment-mode-rtirq \
        --remove --rename --divert /etc/rtirq.conf.rtirq /etc/rtirq.conf
fi

case "$1" in
    remove)
        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null || true

            # rtirq goes back to its own configuration, irqbalance loses the
            # experiment mode drop-in. deb-systemd-invoke only (re)starts
            # units that are enabled or running, and honours policy-rc.d.
            deb-systemd-invoke restart 'rtirq.service' 'irqbalance.service' >/dev/null 2>&1 || true
        fi

        # Reload udev rules and trigger events
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload || true
            udevadm trigger || true
        fi

        # Update grub without experiment mode
        if command -v update-grub >/dev/null 2>&1; then
            update-grub 2>/dev/null || true
        fi
        ;;
    purge)
        # Forget the enable state of auto-pin-audio.service
        # (the snippet dh_installsystemd generates)
        if [ -x "/usr/bin/deb-systemd-helper" ]; then
            deb-systemd-helper purge 'auto-pin-audio.service' >/dev/null || true
        fi
        ;;
esac

exit 0
