[Desktop Entry]
Version=1.0
Type=Application
Terminal=false
Exec=matlab -desktop -r "edit %f"
Name=MATLAB Edit
GenericName=Scientific Computing
Icon=/usr/share/icons/matlab.png
Categories=Development;Math;Science
Keywords=matlab;editor;script;mathworks;
Comment=Open a file in the MATLAB editor
Comment[zh_CN] = 科学计算环境
StartupNotify=true
StartupWMClass=com-mathworks-util-PostVMInit
