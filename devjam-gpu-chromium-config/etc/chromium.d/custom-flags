# A set of command line flags that we want to set by default.

# --- Platform backend (X11 / Wayland auto) ---
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS \
  --ozone-platform-hint=auto \
  --ignore-gpu-blocklist"

# --- Video Acceleration / VAAPI / HEVC / VP9 ---
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS \
  --enable-features=\
VaapiIgnoreDriverChecks,\
VaapiLowPowerEncoderGen9x,\
Vp9kSVCHWDecoding,\
VaapiVp9kSVCHWEncoding,\
PlatformHEVCDecoderSupport,\
PlatformHEVCEncoderSupport,\
AcceleratedVideoDecoder,\
AcceleratedVideoEncoder,\
AcceleratedVideoDecodeLinuxGL,\
AcceleratedVideoDecodeLinuxZeroCopyGL,\
UseMultiPlaneFormatForHardwareVideo,\
CanvasOopRasterization"

# --- Rasterization / Canvas / GPU rendering ---
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS \
  --enable-gpu-compositing \
  --enable-gpu-rasterization \
  --canvas-oop-rasterization \
  --enable-accelerated-2d-canvas \
  --enable-parallel-downloading"

# --- Vulkan / ANGLE backend ---
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS \
  --enable-features=Vulkan,DefaultANGLEVulkan,VulkanFromANGLE"

# --- Memory Buffers / Overlays / Zero-copy ---
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS \
  --enable-native-gpu-memory-buffers \
  --enable-gpu-memory-buffer-video-frames \
  --enable-gpu-memory-buffer-compositor-resources \
  --enable-zero-copy \
  --enable-hardware-overlays \
  --video-capture-use-gpu-memory-buffer"

# --- Screenshots / UI enhancements ---
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS \
  --enable-features=DesktopScreenshots,SharingDesktopScreenshotsEdit,WebUIDarkMode \
  --enable-font-antialiasing"
